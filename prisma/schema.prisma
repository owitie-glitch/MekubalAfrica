// MEKUBAL — Mekubal Africa (Mekubal East Africa)
//
// Single-seller store: Mekubal sells its own handmade ornaments directly. There is
// no Shop model and no per-shop order splitting; an Order owns its OrderItems
// outright. The prior multi-vendor schema is preserved in git history if the
// store ever opens to other artisans.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- identity

enum UserRole {
  CUSTOMER
  ADMIN // Mekubal staff: manages catalogue and fulfils orders
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  image         String?
  role          UserRole  @default(CUSTOMER)
  emailVerified DateTime?

  orders    Order[]
  addresses Address[]
  reviews   Review[]
  cart      Cart?
  sessions  Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Address {
  id         String  @id @default(cuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName   String
  line1      String
  line2      String?
  city       String
  region     String
  postalCode String
  country    String  @default("Kenya")
  phone      String?
  isDefault  Boolean @default(false)

  orders Order[]

  @@index([userId])
}

// ----------------------------------------------------------------- catalog

model Category {
  id       String  @id @default(cuid())
  slug     String  @unique
  name     String
  imageUrl String?
  position Int     @default(0)

  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  products Product[]

  @@index([parentId])
}

/// An editorial grouping — "Brass Collection", "Festive 2026". Drives the
/// full-bleed campaign blocks on the home page.
model Collection {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  headline    String?
  description String?
  heroImage   String?
  position    Int     @default(0)

  products Product[]

  createdAt DateTime @default(now())
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Product {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  description String?
  status      ProductStatus @default(DRAFT)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  collectionId String?
  collection   Collection? @relation(fields: [collectionId], references: [id])

  // Craft detail buyers actually ask about before buying a handmade piece.
  material  String?
  artisan   String? // the maker's name — Mekubal sells their work, not anonymous stock
  origin    String? // "Kisii, Kenya"
  dimensions String?

  // Editorial flag: hand-picked for the home page rather than inferred from
  // sales, because a new catalogue has no sales to infer from.
  featured Boolean @default(false)

  images   ProductImage[]
  variants ProductVariant[]
  reviews  Review[]

  // Denormalised for cheap sorting on listing pages; recomputed on write.
  ratingAvg   Float   @default(0)
  ratingCount Int     @default(0)
  priceMin    Decimal @default(0) @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([collectionId])
  @@index([status])
  @@index([featured])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  position  Int     @default(0)

  @@index([productId])
}

// Every product has at least one variant, even single-option ones, so price
// and stock never live in two places.
model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  name      String
  sku       String?  @unique
  price     Decimal  @db.Decimal(10, 2)
  compareAt Decimal? @db.Decimal(10, 2)
  inventory Int      @default(0)

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
}

model Review {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  body      String?

  createdAt DateTime @default(now())

  @@unique([productId, userId])
  @@index([productId])
}

// -------------------------------------------------------------------- cart

model Cart {
  id     String  @id @default(cuid())
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Guests get a cart keyed by cookie until they sign in.
  sessionToken String? @unique

  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int            @default(1)

  @@unique([cartId, variantId])
  @@index([cartId])
}

// ------------------------------------------------------------------ orders

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  status      OrderStatus @default(PENDING_PAYMENT)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  addressId String?
  address   Address? @relation(fields: [addressId], references: [id])

  subtotal Decimal @db.Decimal(10, 2)
  shipping Decimal @default(0) @db.Decimal(10, 2)
  tax      Decimal @default(0) @db.Decimal(10, 2)
  total    Decimal @db.Decimal(10, 2)
  currency String  @default("KES")

  stripePaymentIntentId String? @unique

  trackingNumber String?
  carrier        String?
  shippedAt      DateTime?

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  // Snapshotted at purchase: renaming or repricing a product must never
  // rewrite an old receipt.
  titleSnapshot   String
  variantSnapshot String
  imageSnapshot   String?
  unitPrice       Decimal @db.Decimal(10, 2)
  quantity        Int

  @@index([orderId])
}
